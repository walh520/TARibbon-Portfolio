// TARibbon v0.1 portable GPU ABI.  Every StructuredBuffer element is float4 or uint4 (16 bytes).
// Positions are meters in the simulation frame; time is seconds; Z is up.
#ifndef TARIBBON_COMMON_USH
#define TARIBBON_COMMON_USH

static const uint TR_FLAG_VALID       = 1u;
static const uint TR_FLAG_ART_WIND    = 2u;
static const uint VTX_FLAG_HARD_PIN   = 1u;
static const uint CONTACT_PLANE        = 0u;
static const uint CONTACT_SPHERE       = 1u;
static const uint CONTACT_CAPSULE      = 2u;
static const float TR_EPS              = 1.0e-8f;
static const float NORMALIZE2_FLOOR    = 1.0e-24f; // squared-vector floor; dimensions follow the caller
static const float CROSS2_FLOOR        = 1.0e-24f; // m^4 for dihedral cross products
static const float AREA2_FLOOR         = 1.0e-12f; // m^2 for triangle double-area
static const float PI                  = 3.14159265358979323846f;
static const float TWO_PI              = 6.28318530717958647692f;

// Params: Params0=(dt, invDt, dampingRate, gravityScale)
// Params1=(rhoAir, globalWindClamp, particleThickness, contactSlop)
// Params2=(softPinGlobalScale, reserved, maxSpeed, windAccelerationClamp)
// Params3=(vertexCount, triangleCount, hingeCount, colliderCount), count lanes are asuint.
// These are loose shader parameters so their names match FTARibbonShaderParameters.
// Do not wrap them in a named cbuffer: UE binds the individual fields, not a
// single parameter named RibbonParameters.
float4 Params0;
float4 Params1;
float4 Params2;
float4 Params3;
float4 GravityAndTime; // xyz gravity m/s^2, w actual simulated time
float4 ArtWindParams;  // x enabled (0/1), y waveCount <= 4, z global amplitude multiplier, w asset phase seed
float4 PassParams;     // x=asfloat(active color index), y=renderVertexCount, z,w reserved

uint RVertexCount()   { return asuint(Params3.x); }
uint RTriangleCount() { return asuint(Params3.y); }
uint RHingeCount()    { return asuint(Params3.z); }
uint RColliderCount() { return asuint(Params3.w); }
uint RActiveColor() { return asuint(PassParams.x); }
uint RRenderVertexCount() { return asuint(PassParams.y); }
float WrapPi(float a) { return a - TWO_PI * floor((a + PI) / TWO_PI); }
float3 SafeNormalize(float3 x, float3 fallback) { float l2=dot(x,x); return (l2>NORMALIZE2_FLOOR) ? x*rsqrt(l2) : fallback; }
float3 AnyPerpendicular(float3 n)
{
    float3 a = (abs(n.z) < 0.8f) ? float3(0,0,1) : float3(0,1,0);
    return SafeNormalize(cross(a,n), float3(1,0,0));
}
uint PackedUint(StructuredBuffer<uint4> b, uint scalarIndex)
{
    uint4 q = b[scalarIndex >> 2u];
    uint lane = scalarIndex & 3u;
    return (lane == 0u) ? q.x : ((lane == 1u) ? q.y : ((lane == 2u) ? q.z : q.w));
}

// Triangle ABI: TriIndices=(v0,v1,v2,flags). TriRest0=(restFiberU.xyz,A0).
// TriRest1=(restFiberV.xyz, invDm00). TriRest2=(invDm01,invDm10,invDm11,Ku).
// TriRest3=(Kv,Ks,Cd,Ct). TriRest4=(windMask, permeability, phaseLabel, unused).
// TriArtCoord=(materialU,materialV,restLabel,artMask).
float3 TriangleFu(float3 x0,float3 x1,float3 x2,float4 r1,float4 r2)
{ return (x1-x0)*r1.w + (x2-x0)*r2.y; }
float3 TriangleFv(float3 x0,float3 x1,float3 x2,float4 r1,float4 r2)
{ return (x1-x0)*r2.x + (x2-x0)*r2.z; }
void TriangleGradientCoefficients(float4 r1, float4 r2, out float3 au, out float3 av)
{
    au=float3(-(r1.w+r2.y), r1.w, r2.y);
    av=float3(-(r2.x+r2.z), r2.x, r2.z);
}
// Current collapse test is expressed in current double-area (m^2), relative to rest A0.
bool TriangleCollapsed(float3 x0,float3 x1,float3 x2,float restArea)
{
    float area2=length(cross(x1-x0,x2-x0));
    return area2<=max(AREA2_FLOOR,2.0e-6f*max(restArea,0.0f));
}

// Analytic gradient for the signed atan2 convention above. It was checked offline by central differences.
void DihedralAnalyticGradients(float3 p0,float3 p1,float3 p2,float3 p3,float restEdgeLength,
                               out float3 g0,out float3 g1,out float3 g2,out float3 g3,out bool valid)
{
    float3 e=p1-p0; float e2=dot(e,e); float3 n0=cross(e,p2-p0), n1=cross(p3-p0,e);
    float n02=dot(n0,n0), n12=dot(n1,n1);
    float relE=max(NORMALIZE2_FLOOR,1.0e-12f*restEdgeLength*restEdgeLength);
    float relN=max(CROSS2_FLOOR,1.0e-12f*restEdgeLength*restEdgeLength*restEdgeLength*restEdgeLength);
    valid=(e2>relE && n02>relN && n12>relN); g0=0;g1=0;g2=0;g3=0;
    if(!valid)return;
    float L=sqrt(e2),s2=dot(p2-p0,e)/e2,s3=dot(p3-p0,e)/e2;
    g2=-L*n0/n02;g3=-L*n1/n12;g0=(s2-1.0f)*g2+(s3-1.0f)*g3;g1=-s2*g2-s3*g3;
}
// Finite-difference validation is intentionally offline-only (see Docs/GPU_ABI.md); the runtime uses the analytic form above.

#endif
